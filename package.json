{
  "name": "the-lost-storm",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "The Lost Storm: a single-player isometric action RPG on Three.js, in TypeScript.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings",
    "check": "npm run typecheck && npm run lint && npm test",
    "test": "node --test 'sim/**/*.test.ts' 'src/**/*.test.ts' 'test/**/*.test.ts'",
    "assets:inspect": "node tools/inspect-glb.ts"
  },
  "dependencies": {
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.1.1",
    "@gltf-transform/functions": "^4.1.1",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
